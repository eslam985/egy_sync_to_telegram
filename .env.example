# ============================================================
# EgySync - Local Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!
# ============================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Telegram
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=1234567890:AABBccDDeeffGGhhIIjjKKllMMnnOOpp
TELEGRAM_TARGET_CHAT=@YourBotOrChannel

# Optional — override defaults
# POLL_INTERVAL_SECONDS=3600 فاصل الاستطلاع بالثواني#
# MAX_DOWNLOAD_RETRIES=3
# MAX_VIDEO_SIZE_GB=1.9
# SOURCE_SERVERS=streamtape,mixdrop,vk,download
# MIXDROP_MAX_CLICK_ATTEMPTS=10
# UPLOAD_WAIT_SECONDS=12
# SESSION_FILE=egy_sync_session

